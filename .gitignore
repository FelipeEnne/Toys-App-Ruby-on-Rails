# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/db/*.sqlite3
/db/*.sqlite3-journal
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

/node_modules
/yarn-error.log

.byebug_history

/config/master.key
/config/credentials/*.key
.env
.env.*

/ref-rails8/
